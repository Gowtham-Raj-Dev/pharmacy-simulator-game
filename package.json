{
  "name": "rxshift-pharmacy-sim",
  "version": "3.0.2",
  "private": true,
  "description": "RxShift — 3D pharmacy training simulator for Android & iOS (educational)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:app": "vite build --mode app",
    "preview": "vite preview --host",
    "cap:sync": "npm run build:app && npx cap sync android",
    "android": "npm run build:app && npx cap sync android && npx cap open android",
    "ios": "vite build --mode app-mp3 && npx cap sync ios && npx cap open ios",
    "site": "vite build && node tools/site.mjs",
    "site:preview": "npx vite preview --outDir site --host"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^0.22.0",
    "playwright": "1.55",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
